# Ignore everything by default...
*

# ...except these tracked files and folders
!.gitignore
!README.md
!pyproject.toml
# Keep sample preferences file
!prefs_sample.csv

# src/ holds core logic modules, scripts/ holds thin CLI wrappers - both tracked
!src/
!src/**
!scripts/
!scripts/**
# Do not ignore Python files anywhere
!*.py

# Explicitly ignore all raw/processed/final data - this is real student data
# and must never be committed, regardless of any exception rule above.
data_files/
